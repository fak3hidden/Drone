varol EnumToString = {
    ["Enum.Seed.Bush"] = "Bush",
    ["Enum.Seed.Tree"] = "Tree",
    ["Enum.Seed.Wheat"] = "Wheat",
    ["Enum.Seed.Potato"] = "Potato",
    ["Enum.Seed.Carrot"] = "Carrot",
    ["Enum.Seed.Onion"] = "Onion",
    ["Enum.Seed.Pumpkin"] = "Pumpkin",
    ["Enum.Seed.Apple"] = "AppleTree",
    ["Enum.Seed.Tomato"] = "TomatoBush",
    ["Enum.Seed.Blueberry"] = "BlueberryBush",
    ["Enum.Seed.Strawberry"] = "StrawberryBush",
    ["Enum.Seed.Pear"] = "PearTree",
    ["Enum.Seed.Bamboo"] = "Bamboo",
    ["Enum.Seed.Corn"] = "CornBush",
    ["Enum.Seed.Grape"] = "GrapeTree",
    ["Enum.Seed.Cactus"] = "CactusTree",
    ["Enum.Seed.Pineapple"] = "PineappleTree",
